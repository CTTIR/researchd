# ============================================================
# Scheduler container — per-question email distribution.
# ============================================================
FROM python:3.12-slim
WORKDIR /app
# Upper bound: see the note in Dockerfile.web.
RUN pip install --no-cache-dir "croniter>=2.0,<7.0"
COPY web/scheduler.py ./web/scheduler.py
CMD ["python3", "web/scheduler.py"]

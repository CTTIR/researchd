# Copy to `.env` (gitignored). docker-compose reads this automatically.

# ===== master encryption key (REQUIRED) =====
# Generate once:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=paste_a_generated_fernet_key_here

# ===== fetch scheduling (R engine) =====
# How often to FETCH new records (cron). Email cadence is per-question in the UI.
# FULL pipeline run (literature + signals). Daily is plenty for literature.
CRON_SCHEDULE=0 6 * * *
# FAST signals-only lane (SEC, IR, wires, registries). Hourly serves the
# "be first" goal; tighten to */30 or */15 min if you want lower latency.
CRON_FAST_SCHEDULE=15 * * * *
RUN_ON_START=0
TZ=Europe/Berlin

# ===== web service =====
WEB_PORT=8000
BASE_URL=https://feeds.yourdomain.com
FEED_LIMIT=100
# Set to 0 ONLY if serving plain HTTP without TLS (cookies won't be Secure).
SECURE_COOKIE=1

# Machine-to-machine token for the /api/ingest endpoint (n8n, scripts).
# Generate a long random string. If left empty, /api/ingest returns 503
# (disabled) so it can never accept unauthenticated writes.
# e.g.  openssl rand -hex 32
INGEST_TOKEN=

# Bearer token for the /api/v1 surface that the researchR R client uses.
# Generate a long random string (openssl rand -hex 32). Empty = /api/v1
# returns 503 (disabled), so it can never serve unauthenticated.
API_TOKEN=

# ===== email (scheduler service) — your own SMTP server =====
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_USER=pipeline@yourdomain.com
SMTP_FROM=pipeline@yourdomain.com
SMTP_TLS=starttls          # starttls (587) | ssl (465) | none
EMAIL_PW=your_smtp_password
CHECK_INTERVAL=900         # how often the scheduler checks due-ness (seconds)

# ===== optional global keys / contact =====
ENTREZ_KEY=
ZOTERO_KEY=
CONTACT_EMAIL=you@yourdomain.com
